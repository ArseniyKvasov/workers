{
  "name": "workers-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted platform for running Cloudflare Workers-compatible code with D1, KV, Queues and Secrets bindings",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @platform/catalog db:generate",
    "db:migrate": "pnpm --filter @platform/catalog db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "@types/node": "^20.17.9"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@cloudflare/workerd",
      "workerd",
      "drizzle-kit",
      "pg",
      "cpu-features"
    ]
  }
}
