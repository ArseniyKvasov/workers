# --- Required ---------------------------------------------------------------
# PostgreSQL connection string for the platform catalog
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workers_platform

# Master key for secret encryption (age-style envelope, AES-256-GCM + HKDF).
# Generate one with: openssl rand -base64 32
SECRETS_MASTER_KEY=

# Static management API key. /api/* (deploy code, secrets, logs, D1, KV, etc.)
# requires `Authorization: Bearer <API_KEY>`. Workers are public via /w/<name>.
API_KEY=

# --- Optional ---------------------------------------------------------------
# Redis-compatible server (Dragonfly/Redis/Valkey) backing KV and Queues
REDIS_URL=redis://localhost:6379

# HTTP port of the control plane
PORT=3000

# --- Blue/Green production deploy (see deploy/production.sh) ----------------
# Public domain nginx serves; ports for the two slots.
DOMAIN=workers.example.com
BLUE_PORT=3100
GREEN_PORT=3200

# Directory for D1 SQLite files and libSQL platform storage
DATA_DIR=./data

# Rate limiting on the control plane (per API key)
API_RATE_LIMIT_PER_MINUTE=600
API_RATE_LIMIT_BURST=100

# Egress allowlist for worker outbound fetches (comma-separated hostnames or
# wildcard entries like *.example.com). Empty = deny all egress.
EGRESS_ALLOWED_DOMAINS=

# Logging
LOG_LEVEL=info
RUNTIME_LOG_LEVEL=warn

# Service name used in structured logs
SERVICE_NAME=workers-platform
