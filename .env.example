# --- Required ---------------------------------------------------------------
# PostgreSQL connection string for the platform catalog. Use a strong password.
# In Docker Compose: postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/workers_platform
# On host (dev): postgresql://postgres:<POSTGRES_PASSWORD>@host.docker.internal:5432/workers_platform
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@host.docker.internal:5432/workers_platform

# Master key for secret encryption (AES-256-GCM + HKDF)
# Generate one with: openssl rand -base64 32
SECRETS_MASTER_KEY=

# Static management API key. /api/* (deploy code, secrets, logs, D1, KV, etc.)
# requires `Authorization: Bearer <API_KEY>`. Worker ingress /w/<uuid> requires
# the per-worker x-ingress-token (returned once at worker creation).
# Generate: openssl rand -hex 16 | sed 's/^/wpk_/'
API_KEY=

# --- Optional ---------------------------------------------------------------
# Redis-compatible server (Dragonfly/Redis/Valkey) backing KV and Queues
# In Docker Compose: redis://redis:6379
# On host (dev): redis://host.docker.internal:6380 (if separate Redis on 6380)
REDIS_URL=redis://host.docker.internal:6380

# HTTP port of the control plane
PORT=3000

# --- Security hardening ------------------------------------------------------
# Rate limiting for the public worker ingress /w/:id (per client IP + worker).
# Public worker ingress limits (per client IP + worker)
INGRESS_RATE_LIMIT_PER_MINUTE=120
INGRESS_RATE_LIMIT_BURST=30
# Comma-separated exact IPs or IPv4 CIDRs exempt from API and ingress rate limits
RATE_LIMIT_EXEMPT_IPS=
# Max accepted request body, bytes (413 above).
MAX_BODY_BYTES=10485760
# Reverse proxies allowed to set x-forwarded-for (IPs / IPv4 CIDRs, comma-sep).
# Example: TRUSTED_PROXIES=127.0.0.1,::1,10.0.0.0/8
TRUSTED_PROXIES=
# CORS allowlist for browser clients (comma-separated origins).
# Empty = no CORS headers are emitted (server-to-server and same-origin only).
CORS_ALLOWED_ORIGINS=
# When set, GET /metrics requires `Authorization: Bearer <METRICS_TOKEN>`.
METRICS_TOKEN=
# Timeout for worker outbound fetches (egress), ms.
EGRESS_TIMEOUT_MS=120000

# --- Log retention -----------------------------------------------------------
# How often to run log cleanup (ms). Default 1 hour.
LOG_RETENTION_INTERVAL_MS=3600000
# Max age of logs to keep (seconds). Default 7 days.
LOG_RETENTION_SECONDS=604800

# --- Blue/Green production deploy (see deploy/production.sh) ----------------
# Public domain nginx serves; host ports for the two slots (published on
# 127.0.0.1 for host nginx to proxy to; app listens on 3000 inside containers).
DOMAIN=workers.example.com
BLUE_PORT=3100
GREEN_PORT=3200

# Nginx site conf updated by deploy (ONLY this file; nginx itself is managed
# externally — script never restarts it, only graceful `nginx -s reload`).
NGINX_CONFIG_PATH=/etc/nginx/sites-available/workers-platform.conf
# Override reload/test commands if needed, or skip reload with --no-reload.
# NGINX_RELOAD_CMD=sudo nginx -s reload
# NGINX_TEST_CMD=sudo nginx -t
# Health probe through nginx after traffic switch (Host header = $DOMAIN).
PUBLIC_HEALTH_URL=http://127.0.0.1/health
# Seconds to wait for the new slot's /ready (incl. worker warm-up).
HEALTH_TIMEOUT=180
# TLS cert paths (default: letsencrypt live dir for $DOMAIN).
# The 443 block is added to the site conf only when both files exist.
# First issuance: mkdir -p /var/www/certbot &&
#   certbot certonly --webroot -w /var/www/certbot -d workers.example.com &&
#   ./deploy/production.sh   (do NOT use certbot --nginx: wiped on next deploy)
# TLS_CERT_FILE=/etc/letsencrypt/live/workers.example.com/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/workers.example.com/privkey.pem
# Docker network slots join (default: auto-detected from postgres container).
# Set explicitly if detection picks the wrong one (compose project prefix).
# DOCKER_NETWORK=workers_workers-network

# Directory for D1 SQLite files and libSQL platform storage
# In Docker: /data (mounted from workers-data volume)
# On host (dev): ./data
DATA_DIR=/var/lib/workers-platform

# Rate limiting on the control plane (per API key)
# Management API limits
API_RATE_LIMIT_PER_MINUTE=300
API_RATE_LIMIT_BURST=50

# Egress allowlist for worker outbound fetches (comma-separated hostnames or
# wildcard entries like *.example.com). Empty = deny all egress.
EGRESS_ALLOWED_DOMAINS=

# --- S3 Backups (used by deploy/production.sh) ------------------------------
# S3 bucket for backups
S3_BACKUP_BUCKET=
# Prefix/path within bucket
S3_BACKUP_PREFIX=workers-platform
# How many recent backups to keep (count, not days)
BACKUP_RETENTION=14
# AWS credentials (or use IAM role / instance profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# For S3-compatible storage (MinIO, Selectel, Yandex Object Storage, etc.)
S3_ENDPOINT=

# Logging
LOG_LEVEL=info
RUNTIME_LOG_LEVEL=warn
SERVICE_NAME=workers-platform

# --- Docker / Deploy --------------------------------------------------------
POSTGRES_USER=postgres
# REQUIRED, no default: compose refuses to start without it.
# Any password works (the image entrypoint percent-encodes it into the URL),
# but URL-safe hex is the least surprising: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=workers_platform
# Hostnames/ports as seen from INSIDE the app container (compose network).
# The entrypoint rebuilds DATABASE_URL/REDIS_URL from these parts.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# REQUIRED: Redis auth (compose refuses to start without it).
# Generate: openssl rand -hex 24
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379

# Host ports for Docker Compose (change if ports are occupied)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6380
APP_HOST_PORT=3000
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

IMAGE_NAME=workers-platform
CONTAINER_MEMORY=2g
CONTAINER_CPUS=2