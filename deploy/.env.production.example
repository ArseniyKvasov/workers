# --- Blue/Green slots -------------------------------------------------------
# Public domain nginx serves; ports for the two slots.
DOMAIN=workers.example.com
BLUE_PORT=3100
GREEN_PORT=3200

# Where nginx reads the rendered site config
NGINX_CONFIG_PATH=/etc/nginx/sites-available/workers-platform.conf

# --- Application ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/workers_platform
REDIS_URL=redis://redis:6379

# openssl rand -base64 32 — rotating this makes stored secrets undecryptable!
SECRETS_MASTER_KEY=

# Management API key (/api/*). Workers stay public via /w/<name>.
API_KEY=

# Host directory with D1 SQLite files; mounted into both slots at /data
DATA_DIR_HOST=/var/lib/workers-platform

# --- Docker -----------------------------------------------------------------
IMAGE_NAME=workers-platform
CONTAINER_MEMORY=2g
CONTAINER_CPUS=2

# --- S3 backups (taken at the start of every deploy) ------------------------
S3_BACKUP_BUCKET=my-backups
S3_BACKUP_PREFIX=workers-platform
BACKUP_RETENTION=14

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# For S3-compatible storage (MinIO, Selectel, Yandex Object Storage):
S3_ENDPOINT=

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=info

# --- Docker Compose / Database ----------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workers_platform
IMAGE_NAME=workers-platform
CONTAINER_MEMORY=2g
CONTAINER_CPUS=2