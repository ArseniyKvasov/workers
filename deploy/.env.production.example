# Workers Platform — production deploy configuration
# Copy to deploy/.env.production on the server and fill in.

# --- Blue/Green slots -------------------------------------------------------
# Public domain served by nginx (rendered into nginx.conf.template)
DOMAIN=workers.example.com

# Ports for the two slots. Each slot is a docker container bound via
# --network host to its port; nginx proxies to the active one.
BLUE_PORT=3100
GREEN_PORT=3200

# Where nginx reads the rendered site config (deploy/production.sh writes it
# and runs `nginx -t` + `nginx -s reload`)
NGINX_CONFIG_PATH=/etc/nginx/sites-available/workers-platform.conf

# --- Application ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workers_platform
REDIS_URL=redis://localhost:6379

# openssl rand -base64 32 — rotating this makes stored secrets undecryptable!
SECRETS_MASTER_KEY=

# Management API key (/api/*). Workers stay public via /w/<name>.
API_KEY=

# Host directory with D1 SQLite files + libSQL storage; mounted into both
# slots at /data so blue and green share worker databases during the switch.
DATA_DIR_HOST=/var/lib/workers-platform

# --- Docker -----------------------------------------------------------------
IMAGE_NAME=workers-platform
CONTAINER_MEMORY=2g
CONTAINER_CPUS=2

# --- S3 backups (taken at the start of every deploy) ------------------------
S3_BACKUP_BUCKET=my-backups
S3_BACKUP_PREFIX=workers-platform
BACKUP_RETENTION=14

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# For S3-compatible storage (MinIO, Selectel, Yandex Object Storage):
S3_ENDPOINT=

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=info
