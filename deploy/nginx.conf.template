# Workers Platform — nginx reverse proxy (rendered by deploy/production.sh)
# Template variables replaced at deploy time: DOMAIN and the active slot port.
#
# NOTE: this is a *site* conf (e.g. /etc/nginx/sites-available/workers-platform.conf).
# The deploy script only ever rewrites this one file and performs a graceful
# `nginx -s reload`. It never touches nginx.conf, other sites, or restarts nginx.
#
# The app slot publishes 127.0.0.1:<BLUE_PORT|GREEN_PORT> -> 3000, so host nginx
# proxies to loopback (docker container names are NOT resolvable from host nginx).

upstream workers_platform_app {
    server 127.0.0.1:__ACTIVE_PORT__;
    keepalive 32;
}

server {
    listen 80;
    server_name __DOMAIN__;

    # Let's Encrypt webroot — must stay outside the proxy so
    # `certbot certonly --webroot` works (and renewals keep working).
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        access_log off;
    }

    # Workers public ingress + control plane API + health endpoints
    location / {
        proxy_pass http://workers_platform_app;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";

        # SSE log streams: no buffering, long reads
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        # Worker deploys can carry up to 5 MB of code
        client_max_body_size 10m;
    }

    # Instant health probes without access-log noise
    location = /health {
        access_log off;
        proxy_pass http://workers_platform_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}

# TLS: appended automatically from nginx.tls-snippet.template when
# /etc/letsencrypt/live/<domain>/fullchain.pem exists (see deploy script).
# First-time issuance (run AFTER a deploy so the acme location above exists):
#   mkdir -p /var/www/certbot
#   certbot certonly --webroot -w /var/www/certbot -d <your-domain>
#   ./deploy/production.sh   # picks up the cert, adds the 443 block
# Renewals need nothing: webroot auth does not touch nginx config.
