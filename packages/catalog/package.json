    "db:migrate": "tsx src/migrate-cli.ts"
  },
  "dependencies": {
    "@platform/types": "workspace:*",
    "drizzle-orm": "^0.38.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2"
  }
}
